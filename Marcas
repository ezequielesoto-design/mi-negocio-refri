<label>¿Qué vas a refrigerar? (Parámetros Embraco/Tecumseh)</label>
<select id="producto" onchange="calcularRefri()">
    <option value="0">Selecciona el uso...</option>
    <option value="280">Exhibidora Tortas/Pastelería (+2°C/+8°C)</option>
    <option value="420">Mostrador Fiambres/Lácteos (0°C/+5°C)</option>
    <option value="750">Cámara/Isla Congelados (-18°C/-23°C)</option>
</select>

<script>
    function calcularRefri() {
        const factor = parseFloat(document.getElementById('producto').value);
        const m = parseFloat(document.getElementById('metros').value) || 0;
        
        if (factor === 0 || m === 0) {
            document.getElementById('resRefri').innerHTML = "Potencia sugerida: <strong>0 Watts</strong>";
            return;
        }

        const totalWatts = factor * m;
        let sugerenciaMotor = "";

        // Lógica de sugerencia de motor aproximada basada en Watts de extracción
        if (totalWatts < 300) sugerenciaMotor = "Sugerido: Motor 1/4 HP (Media Temp)";
        else if (totalWatts < 500) sugerenciaMotor = "Sugerido: Motor 1/3 HP o 1/2 HP (Media Temp)";
        else if (totalWatts < 850) sugerenciaMotor = "Sugerido: Motor 3/4 HP (Baja/Media)";
        else sugerenciaMotor = "Sugerido: Motor 1 HP o superior / Unidad Condensadora";

        document.getElementById('resRefri').innerHTML = `
            Potencia necesaria: <strong>${totalWatts.toFixed(0)} Watts</strong><br>
            <span style="color:#0056b3; font-size: 0.9em;">${sugerenciaMotor}</span>
        `;
    }

    // Mantener la función de Aire Acondicionado igual o actualizarla así:
    function calcularAire() {
        const l = document.getElementById('largo').value || 0;
        const a = document.getElementById('ancho').value || 0;
        const h = document.getElementById('alto').value || 1; // Evitar división por cero
        
        // 50 Watts por m3 es un estándar seguro para marcas comerciales
        const watts = l * a * h * 50;
        const frigorias = watts * 0.86;
        
        document.getElementById('resAire').innerHTML = `
            Capacidad: <strong>${frigorias.toFixed(0)} Frigorías</strong><br>
            <small>Equivalente a aprox. ${(watts/1000).toFixed(1)} kW</small>
        `;
    }
</script>
